---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import SectionLabel from "@/components/SectionLabel.astro";
import { LOCALES, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { entrySlug, getPosts } from "@/lib/content";

export const getStaticPaths = (async () => {
  const perLocale = await Promise.all(
    LOCALES.map(async (lang) =>
      (await getPosts(lang)).map((entry) => ({
        params: { lang, slug: entrySlug(entry) },
        props: { entry },
      })),
    ),
  );
  return perLocale.flat();
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString(locale, { dateStyle: "long", timeZone: "UTC" });
---

<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <SectionLabel as="p">
      {t("nav.blog")} · <time datetime={entry.data.date.toISOString()}>{date}</time>
    </SectionLabel>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>

<style>
  .article {
    max-width: var(--prose-width);
    padding-block: var(--space-12);
  }
</style>
