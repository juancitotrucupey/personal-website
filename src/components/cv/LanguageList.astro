---
import type { LanguageSkill } from "@/data/cv.types";
import type { Locale } from "@/i18n/config";

interface Props {
  languages: readonly LanguageSkill[];
  locale: Locale;
}

const { languages, locale } = Astro.props;
---

<ul class="languages">
  {languages.map((language) => (
    <li>
      {language.name[locale]} <span class="level">{language.level}</span>
    </li>
  ))}
</ul>

<style>
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .level {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
