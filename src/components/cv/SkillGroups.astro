---
import type { SkillGroup } from "@/data/cv.types";
import type { Locale } from "@/i18n/config";

interface Props {
  groups: readonly SkillGroup[];
  locale: Locale;
}

const { groups, locale } = Astro.props;
---

<dl class="skills">
  {groups.map((group) => (
    <div class="group">
      <dt>{group.label[locale]}</dt>
      <dd>
        <ul class="chips">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </dd>
    </div>
  ))}
</dl>

<style>
  .skills {
    margin: 0;
  }

  .group + .group {
    margin-top: var(--space-4);
  }

  dt {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
